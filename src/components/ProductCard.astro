---
import type { Product } from '../lib/products'
import { formatPrice } from '../lib/products'

interface Props {
  product: Product
}

const { product } = Astro.props
const savings = product.msrp ? product.msrp - product.price : 0
const savingsPct = product.msrp ? Math.round((savings / product.msrp) * 100) : 0
---

<article class="ts-card group flex flex-col overflow-hidden transition hover:-translate-y-0.5 hover:shadow-md">
  <div class="relative aspect-[5/4] bg-gradient-to-br from-slate-50 via-white to-slate-100">
    <div class="absolute inset-0 flex items-center justify-center text-7xl opacity-90 transition group-hover:scale-105">
      {product.icon}
    </div>
    <div class="absolute left-3 top-3 flex flex-col gap-1">
      {product.highlight === 'staff-pick' && (
        <span class="ts-chip-cyan">★ Staff pick</span>
      )}
      {product.highlight === 'limited' && (
        <span class="ts-chip-lime">⚡ Limited drop</span>
      )}
      {product.highlight === 'low-stock' && (
        <span class="ts-chip">Last {product.stock}</span>
      )}
    </div>
    {product.msrp && (
      <span class="absolute right-3 top-3 rounded-md bg-[var(--color-ink)] px-2 py-0.5 text-xs font-semibold text-[var(--color-cyan-glow)]">
        Save {savingsPct}%
      </span>
    )}
  </div>
  <div class="flex flex-1 flex-col p-4">
    <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">{product.brand}</p>
    <h3 class="mt-0.5 line-clamp-2 text-sm font-semibold text-slate-900">{product.name}</h3>
    <p class="mt-1 line-clamp-2 text-xs text-slate-600">{product.blurb}</p>

    <div class="mt-3 flex items-center gap-2 text-xs text-slate-500">
      <span class="ts-chip">{product.condition}</span>
      <span>·</span>
      <span>{product.stock} in stock</span>
    </div>

    <div class="mt-3 flex items-end justify-between">
      <div>
        <div class="font-mono text-lg font-bold text-slate-900">{formatPrice(product.price)}</div>
        {product.msrp && (
          <div class="text-xs text-slate-400 line-through">{formatPrice(product.msrp)}</div>
        )}
      </div>
      <button
        data-add-to-cart
        data-id={product.id}
        data-name={product.name}
        data-price={product.price}
        class="ts-btn-glow px-3 py-2 text-xs"
      >
        Add
      </button>
    </div>
  </div>
</article>
