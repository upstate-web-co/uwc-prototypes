---
import '../styles/global.css'
import SEOHead from '../components/SEOHead.astro'
import { SITE } from '../lib/config'

interface Props {
  title?: string
  description?: string
  ogImage?: string
  schema?: Record<string, unknown>
  active?: string
}

const { title, description, ogImage, schema, active } = Astro.props

const nav = [
  { href: '/', label: 'Home', key: 'home' },
  { href: '/shop', label: 'Shop', key: 'shop' },
  { href: '/services', label: 'Services', key: 'services' },
  { href: '/booking', label: 'Book Repair', key: 'booking' },
  { href: '/faq', label: 'FAQ', key: 'faq' },
  { href: '/about', label: 'About', key: 'about' },
  { href: '/contact', label: 'Contact', key: 'contact' },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;600&display=swap"
    />
    <SEOHead title={title} description={description} ogImage={ogImage} schema={schema} />
  </head>
  <body class="min-h-screen bg-white text-slate-900 antialiased">
    <!-- Friday banner -->
    <div class="ts-friday-stripe bg-[var(--color-ink)] text-white">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-2 text-xs sm:text-sm">
        <span class="flex items-center gap-2">
          <span class="inline-block h-2 w-2 rounded-full bg-[var(--color-lime-glow)] animate-pulse"></span>
          <span class="font-semibold tracking-wide">FRIDAYS — 10% off everything in-store + online</span>
        </span>
        <span class="hidden sm:flex items-center gap-3 text-slate-300">
          <span>{SITE.hours}</span>
          <span class="opacity-60">·</span>
          <a href="tel:+15550102233" class="hover:text-white">{SITE.phone}</a>
        </span>
      </div>
    </div>

    <!-- Header -->
    <header class="sticky top-0 z-30 border-b border-slate-200 bg-white/80 backdrop-blur">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
        <a href="/" class="flex items-center gap-2">
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-[var(--color-ink)] text-[var(--color-cyan-glow)]">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
              <rect x="3" y="4" width="18" height="12" rx="2" />
              <path d="M2 20h20" />
              <path d="M9 8h6" />
            </svg>
          </span>
          <span class="font-display text-lg font-bold tracking-tight">The Tech Shop</span>
        </a>
        <div class="hidden items-center gap-1 md:flex">
          {nav.map((n) => (
            <a
              href={n.href}
              class={`rounded-md px-3 py-2 text-sm transition ${active === n.key ? 'bg-slate-100 font-semibold text-slate-900' : 'text-slate-600 hover:text-slate-900'}`}
            >
              {n.label}
            </a>
          ))}
        </div>
        <div class="flex items-center gap-2">
          <a href="/staff" class="hidden sm:inline-flex ts-chip-cyan" title="Staff portal — clock in/out">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            Staff
          </a>
          <button id="ts-cart-btn" class="ts-btn px-3 py-2 text-xs" aria-label="Open cart">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg>
            <span id="ts-cart-count">0</span>
          </button>
        </div>
      </nav>
      <!-- Mobile nav -->
      <div class="border-t border-slate-200 md:hidden">
        <div class="mx-auto flex max-w-6xl gap-3 overflow-x-auto px-4 py-2 text-sm">
          {nav.map((n) => (
            <a href={n.href} class={`shrink-0 rounded-md px-2 py-1 ${active === n.key ? 'bg-slate-100 font-semibold' : 'text-slate-600'}`}>{n.label}</a>
          ))}
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- Cart drawer (mock) -->
    <div id="ts-cart-drawer" class="pointer-events-none fixed inset-0 z-40 hidden">
      <div id="ts-cart-backdrop" class="absolute inset-0 bg-slate-900/40 opacity-0 transition-opacity"></div>
      <aside class="absolute right-0 top-0 h-full w-full max-w-md translate-x-full bg-white shadow-2xl transition-transform" id="ts-cart-panel">
        <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4">
          <h3 class="font-display text-lg font-bold">Your cart</h3>
          <button id="ts-cart-close" class="text-slate-500 hover:text-slate-900" aria-label="Close cart">✕</button>
        </div>
        <div id="ts-cart-items" class="h-[calc(100%-200px)] overflow-y-auto px-5 py-4 text-sm text-slate-700">
          <p class="text-slate-500">Your cart is empty. Add something tasty from the shop.</p>
        </div>
        <div class="absolute bottom-0 left-0 right-0 border-t border-slate-200 bg-slate-50 px-5 py-4">
          <div class="mb-3 flex items-center justify-between text-sm">
            <span class="text-slate-600">Subtotal</span>
            <span id="ts-cart-subtotal" class="font-mono text-base font-semibold">$0.00</span>
          </div>
          <div id="ts-friday-applied" class="mb-3 hidden rounded-lg bg-lime-50 px-3 py-2 text-xs font-medium text-lime-900 ring-1 ring-lime-200">
            Friday 10% off applied automatically at checkout.
          </div>
          <button id="ts-checkout" class="ts-btn-glow w-full" disabled>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18"/></svg>
            Checkout with Stripe
          </button>
          <p class="mt-2 text-center text-[11px] text-slate-500">Mock checkout · no charge will be made</p>
        </div>
      </aside>
    </div>

    <footer class="mt-20 border-t border-slate-200 bg-[var(--color-ink)] text-slate-200">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <div class="flex items-center gap-2">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-white/10 text-[var(--color-cyan-glow)]">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="h-4 w-4"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M2 20h20"/><path d="M9 8h6"/></svg>
            </span>
            <span class="font-display text-base font-bold text-white">The Tech Shop</span>
          </div>
          <p class="mt-3 max-w-xs text-sm text-slate-400">
            Charlestown's spot for refurbished laptops, phones, consoles, and honest repairs. 15+ years on the floor.
          </p>
        </div>
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-wide text-slate-400">Visit</h4>
          <p class="mt-3 text-sm text-slate-300">{SITE.address}</p>
          <p class="mt-1 text-sm text-slate-300">{SITE.hours}</p>
          <p class="mt-1 text-sm text-slate-300">{SITE.phone}</p>
        </div>
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-wide text-slate-400">Shop</h4>
          <ul class="mt-3 space-y-1 text-sm">
            <li><a href="/shop?cat=laptops" class="hover:text-white">Laptops</a></li>
            <li><a href="/shop?cat=phones" class="hover:text-white">Phones</a></li>
            <li><a href="/shop?cat=consoles" class="hover:text-white">Consoles & Games</a></li>
            <li><a href="/shop?cat=accessories" class="hover:text-white">Accessories</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-wide text-slate-400">Help</h4>
          <ul class="mt-3 space-y-1 text-sm">
            <li><a href="/booking" class="hover:text-white">Book a repair</a></li>
            <li><a href="/services#tradein" class="hover:text-white">Trade-in / resell</a></li>
            <li><a href="/faq" class="hover:text-white">FAQ + AI helper</a></li>
            <li><a href="/staff" class="hover:text-white">Staff portal</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-white/10">
        <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-4 py-4 text-xs text-slate-400 sm:flex-row">
          <p>&copy; {new Date().getFullYear()} {SITE.name}. Local & independent.</p>
          <p>Powered by QuickBooks · Stripe · Upstate Web Co.</p>
        </div>
      </div>
    </footer>

    <script>
      // Lightweight cart drawer (localStorage-backed mock)
      const $ = (s: string) => document.querySelector(s) as HTMLElement | null
      const cartKey = 'tts:cart:v1'

      function readCart(): Array<{ id: string; name: string; price: number; qty: number }> {
        try {
          const raw = localStorage.getItem(cartKey)
          return raw ? JSON.parse(raw) : []
        } catch { return [] }
      }
      function writeCart(items: Array<{ id: string; name: string; price: number; qty: number }>) {
        localStorage.setItem(cartKey, JSON.stringify(items))
        render()
      }
      function isFriday() { return new Date().getDay() === 5 }

      function render() {
        const items = readCart()
        const count = items.reduce((s, i) => s + i.qty, 0)
        const subtotal = items.reduce((s, i) => s + i.price * i.qty, 0)
        const cartCount = document.getElementById('ts-cart-count')
        if (cartCount) cartCount.textContent = String(count)
        const itemsEl = document.getElementById('ts-cart-items')
        if (itemsEl) {
          if (!items.length) {
            itemsEl.innerHTML = '<p class="text-slate-500">Your cart is empty. Add something tasty from the shop.</p>'
          } else {
            itemsEl.innerHTML = items.map(i => `
              <div class="flex items-start justify-between gap-3 border-b border-slate-100 py-3">
                <div>
                  <p class="font-medium text-slate-900">${i.name}</p>
                  <p class="text-xs text-slate-500">Qty ${i.qty}</p>
                </div>
                <div class="text-right">
                  <p class="font-mono text-sm font-semibold">$${(i.price * i.qty / 100).toFixed(2)}</p>
                  <button data-remove="${i.id}" class="mt-1 text-xs text-slate-500 hover:text-red-600">Remove</button>
                </div>
              </div>
            `).join('')
            itemsEl.querySelectorAll<HTMLButtonElement>('[data-remove]').forEach(btn => {
              btn.addEventListener('click', () => {
                const id = btn.getAttribute('data-remove')
                writeCart(readCart().filter(i => i.id !== id))
              })
            })
          }
        }
        const sub = document.getElementById('ts-cart-subtotal')
        if (sub) sub.textContent = '$' + (subtotal / 100).toFixed(2)
        const friday = document.getElementById('ts-friday-applied')
        if (friday) friday.classList.toggle('hidden', !isFriday() || count === 0)
        const checkout = document.getElementById('ts-checkout') as HTMLButtonElement | null
        if (checkout) checkout.disabled = count === 0
      }

      function openDrawer() {
        const d = document.getElementById('ts-cart-drawer')
        const b = document.getElementById('ts-cart-backdrop')
        const p = document.getElementById('ts-cart-panel')
        if (!d || !b || !p) return
        d.classList.remove('hidden')
        d.classList.add('pointer-events-auto')
        requestAnimationFrame(() => {
          b.classList.add('opacity-100')
          p.classList.remove('translate-x-full')
        })
      }
      function closeDrawer() {
        const d = document.getElementById('ts-cart-drawer')
        const b = document.getElementById('ts-cart-backdrop')
        const p = document.getElementById('ts-cart-panel')
        if (!d || !b || !p) return
        b.classList.remove('opacity-100')
        p.classList.add('translate-x-full')
        setTimeout(() => {
          d.classList.add('hidden')
          d.classList.remove('pointer-events-auto')
        }, 200)
      }

      document.getElementById('ts-cart-btn')?.addEventListener('click', openDrawer)
      document.getElementById('ts-cart-close')?.addEventListener('click', closeDrawer)
      document.getElementById('ts-cart-backdrop')?.addEventListener('click', closeDrawer)
      document.getElementById('ts-checkout')?.addEventListener('click', () => {
        const items = readCart()
        const total = items.reduce((s, i) => s + i.price * i.qty, 0) * (isFriday() ? 0.9 : 1)
        alert(`Redirecting to Stripe Checkout…\n\nItems: ${items.length}\nTotal: $${(total / 100).toFixed(2)}${isFriday() ? ' (10% Friday discount applied)' : ''}\n\n(Prototype mock — no real charge.)`)
      })

      // Exposed for other pages
      ;(window as any).TTS = {
        addToCart(item: { id: string; name: string; price: number }) {
          const items = readCart()
          const existing = items.find(i => i.id === item.id)
          if (existing) existing.qty += 1
          else items.push({ ...item, qty: 1 })
          writeCart(items)
          openDrawer()
        },
        openCart: openDrawer,
      }

      render()
    </script>
  </body>
</html>
