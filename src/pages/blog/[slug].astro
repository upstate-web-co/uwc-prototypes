---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { SITE } from '../../lib/config'

export async function getStaticPaths() {
  const slugs = [
    'top-hiking-trails-upstate-sc',
    'best-axe-throwing-venues',
    'game-night-guide',
  ]
  return slugs.map(slug => ({ params: { slug } }))
}

const { slug } = Astro.params

const posts: Record<string, {
  title: string
  content: string
  date: string
  author: string
  category: string
}> = {
  'top-hiking-trails-upstate-sc': {
    title: 'Top 10 Hiking Trails in Upstate SC',
    content: `
      <p>The Upstate of South Carolina is a hiker's paradise. From the Blue Ridge Mountains to the rolling foothills, there are trails for every skill level.</p>
      <h3>1. Paris Mountain State Park</h3>
      <p>Just minutes from downtown Greenville, Paris Mountain offers over 15 miles of trails. The Sulphur Springs Trail is a favorite for its scenic lake views.</p>
      <h3>2. Table Rock State Park</h3>
      <p>A classic Upstate hike with stunning views from the top. The 3.6-mile trail to the summit is challenging but rewarding.</p>
      <h3>3. Swamp Rabbit Trail</h3>
      <p>This 22-mile multi-use trail is perfect for a leisurely walk or bike ride. Connects Greenville to Travelers Rest.</p>
      <p>Stay tuned for more trail recommendations!</p>
    `,
    date: '2026-07-01',
    author: 'The Ogaden Team',
    category: 'hiking',
  },
  'best-axe-throwing-venues': {
    title: 'Best Axe Throwing Venues in Greenville',
    content: `
      <p>Axe throwing has become one of the most popular activities for groups and date nights in Greenville. Here are our top picks:</p>
      <h3>Yee-Haw Axe Throwing</h3>
      <p>Located in downtown Greenville, Yee-Haw offers multiple lanes and a great atmosphere. Walk-ins welcome.</p>
      <h3>Urban Axes Greenville</h3>
      <p>A premier axe throwing venue with professional coaching. Great for corporate events and parties.</p>
      <p>Both venues offer reservations online. Book ahead for weekend availability!</p>
    `,
    date: '2026-06-28',
    author: 'The Ogaden Team',
    category: 'entertainment',
  },
  'game-night-guide': {
    title: 'Ultimate Guide to Game Nights in the Upstate',
    content: `
      <p>Looking for a fun night out? Here's where to find the best game nights in the Upstate.</p>
      <h3>Boardwalk Game Night</h3>
      <p>Every Thursday from 6 PM. Hundreds of board games available. Great food and drink specials.</p>
      <h3>The Local Cue</h3>
      <p>Pool tournaments every Wednesday and Friday. 12 regulation tables and a full bar.</p>
      <h3>Game On Sports Bar</h3>
      <p>Trivia nights on Tuesdays, karaoke on Thursdays. Great for groups.</p>
      <p>Check each venue's schedule for the latest events!</p>
    `,
    date: '2026-06-20',
    author: 'The Ogaden Team',
    category: 'entertainment',
  },
}

const post = posts[slug]

if (!post) {
  return Astro.redirect('/404')
}
---

<BaseLayout title={`${post.title} | ${SITE.name}`} description={post.excerpt}>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <a href="/blog" class="text-sm text-blue-600 hover:text-blue-800">&larr; Back to Blog</a>

    <article class="mt-6">
      <div class="flex items-center gap-2 text-sm text-gray-500">
        <span class="inline-block rounded-full bg-blue-100 px-2 py-1 text-xs font-medium text-blue-800">
          {post.category}
        </span>
        <span>{post.date}</span>
      </div>
      <h1 class="mt-3 text-3xl font-bold text-gray-900">{post.title}</h1>
      <p class="mt-2 text-sm text-gray-500">By {post.author}</p>
      <div class="mt-6 prose prose-gray max-w-none" set:html={post.content} />
    </article>
  </div>
</BaseLayout>
