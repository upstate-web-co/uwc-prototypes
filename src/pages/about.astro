---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="About — The Tech Shop" description="15+ years on the floor: Joshua's story and how The Tech Shop runs." active="about">
  <section class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-10">
      <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">About</p>
      <h1 class="mt-1 font-display text-4xl font-bold tracking-tight">Local. Independent. Run by someone who's actually fixed your model before.</h1>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-10 lg:grid-cols-[1fr_1fr]">
      <div class="prose prose-slate max-w-none">
        <p class="text-lg leading-relaxed text-slate-700">
          I'm <strong>Joshua Mukui</strong>. I've spent the last 15 years repairing and selling tech — from sales floor
          at Best Buy to working the back-room repair bench at a couple of independent shops in the Boston area.
        </p>
        <p class="mt-4 text-slate-700">
          I opened The Tech Shop because I kept hearing the same thing from customers: "I just want someone honest
          who'll tell me the truth about whether this is worth fixing." That's the whole pitch. Honest quotes, real
          warranties, and a stock that I'd personally trust to my own family.
        </p>
        <p class="mt-4 text-slate-700">
          We're small on purpose — about 50 unique products live in the case at a time, refreshed weekly. We do
          repairs in a glass-walled bench so you can see your device while we work. And every Friday, everything is
          10% off, because Fridays are good.
        </p>
        <p class="mt-4 text-slate-700">
          If you're a Charlestown college student or a working pro who just needs a laptop that <em>works</em>, you're
          our person. Come say hi.
        </p>
      </div>

      <div class="space-y-4">
        <div class="ts-card overflow-hidden">
          <div class="aspect-[4/3] bg-gradient-to-br from-slate-200 via-cyan-50 to-lime-50">
            <div class="flex h-full items-center justify-center text-6xl">🛠️</div>
          </div>
          <div class="p-4">
            <p class="font-display text-base font-bold">The bench</p>
            <p class="text-sm text-slate-600">Glass-walled and stocked with parts for every Apple model since 2014, plus mainstream PC laptops and consoles.</p>
          </div>
        </div>
        <div class="ts-card p-5">
          <h3 class="font-display text-lg font-bold">How we run</h3>
          <ul class="mt-3 space-y-2 text-sm text-slate-700">
            <li class="flex gap-2"><span>📒</span> Inventory + bookkeeping sync to QuickBooks Online nightly.</li>
            <li class="flex gap-2"><span>💳</span> Stripe handles online + tap-to-pay in-store.</li>
            <li class="flex gap-2"><span>⏱️</span> Staff clock in/out through the shop's portal — owner cuts checks weekly.</li>
            <li class="flex gap-2"><span>🤖</span> AI assistant answers FAQ and ballparks repair quotes (this site!).</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Timeline -->
    <div class="mt-16">
      <h2 class="font-display text-2xl font-bold">A quick timeline</h2>
      <ol class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {[
          { year: '2011', title: 'First repair job', body: 'Started fixing iPhone screens out of a friend\'s computer shop.' },
          { year: '2014', title: 'Best Buy floor', body: 'Three years at Geek Squad. Learned every Apple and Microsoft model in retail.' },
          { year: '2018', title: 'Indie repair lead', body: 'Lead repair tech at a Cambridge shop — 30+ devices a week.' },
          { year: '2026', title: 'The Tech Shop opens', body: 'My own shop. Honest, local, no upsell.' },
        ].map((step) => (
          <li class="ts-card relative p-5">
            <span class="font-mono text-xs font-bold text-cyan-700">{step.year}</span>
            <p class="mt-1 font-display text-base font-bold">{step.title}</p>
            <p class="mt-1 text-sm text-slate-600">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>

    <div class="mt-16 ts-card grid gap-6 bg-[var(--color-ink)] p-8 text-white sm:grid-cols-[2fr_1fr] sm:items-center">
      <div>
        <h2 class="font-display text-2xl font-bold">Stop by the shop.</h2>
        <p class="mt-2 text-slate-300">218 Bunker Hill St, Charlestown · Mon–Sat 10–7 · Sun 12–5</p>
      </div>
      <a href="/contact" class="ts-btn-glow justify-self-start sm:justify-self-end">Get in touch →</a>
    </div>
  </section>
</BaseLayout>
