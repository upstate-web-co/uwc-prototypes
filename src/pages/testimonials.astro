---
import BaseLayout from '../layouts/BaseLayout.astro'
import { SITE } from '../lib/config'

const testimonials = [
  {
    id: '1',
    name: 'Jessica T.',
    location: 'Greenville, SC',
    content: 'The Ogaden helped me discover so many amazing places I never knew existed! The axe throwing place was a blast.',
    rating: 5,
  },
  {
    id: '2',
    name: 'Mark D.',
    location: 'Travelers Rest, SC',
    content: 'I use this site every weekend to find new hiking trails and restaurants. The community comments are super helpful.',
    rating: 5,
  },
  {
    id: '3',
    name: 'Amanda L.',
    location: 'Spartanburg, SC',
    content: 'Found the best pool hall through The Ogaden. The game night listings are spot on. Highly recommend!',
    rating: 4,
  },
  {
    id: '4',
    name: 'Chris P.',
    location: 'Greenville, SC',
    content: 'Great resource for finding things to do. The photo gallery gives you a real feel for each place before you go.',
    rating: 5,
  },
]
---

<BaseLayout title="Testimonials | {SITE.name}" description="What people are saying about The Ogaden">
  <div class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="text-3xl font-bold text-gray-900">Testimonials</h1>
    <p class="mt-2 text-gray-600">Hear from our community about their experiences.</p>

    <div class="mt-8 space-y-6">
      {testimonials.map(t => (
        <div class="card">
          <div class="flex items-center gap-1">
            {Array.from({ length: 5 }, (_, i) => (
              <svg key={i} class={`h-5 w-5 ${i < t.rating ? 'text-yellow-400' : 'text-gray-300'}`} fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <p class="mt-3 text-gray-700 italic">"{t.content}"</p>
          <div class="mt-4 flex items-center justify-between">
            <p class="font-medium text-gray-900">{t.name}</p>
            <p class="text-sm text-gray-500">{t.location}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
